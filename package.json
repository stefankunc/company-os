{
  "name": "cnt-monorepo",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "pnpm -r --parallel --if-present dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm --filter \"./packages/*\" --if-present typecheck",
    "lint": "oxlint",
    "knip": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "factory": "node packages/factory/src/cli.ts",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm knip"
  },
  "devDependencies": {
    "knip": "^6.48.0",
    "oxlint": "^1.0.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^7.0.2"
  },
  "prettier": {
    "semi": true,
    "singleQuote": false,
    "tabWidth": 2,
    "trailingComma": "es5",
    "printWidth": 100,
    "endOfLine": "lf",
    "plugins": [
      "prettier-plugin-tailwindcss"
    ]
  }
}
